{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" pre", "timeout": 10},
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" dissent", "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep|Write|Edit|MultiEdit",
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" post", "timeout": 10}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/bushido.md\"; python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" pending --limit 5", "timeout": 10}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" mirror-sweep --days 7 >/dev/null 2>&1; python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" brief", "timeout": 60}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/duck.py\" stop", "timeout": 30, "statusMessage": "helmet duck: may the turn end?"}
        ]
      }
    ]
  }
}
